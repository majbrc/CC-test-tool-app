<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Acquisition of CITs" parallel="false" preserve-order="true">

	<test name="Remove test user" parallel="false" preserve-order="true" enabled="false">
        <parameter name="xmlTemplateFile" value="TEST/Telia_Acquire_CITs/test-input-user.xml"/>
        <parameter name="testFilterLabel" value="SUAC_DELETE"/>
        <classes>
            <class name="hr.altima.testng.test.template.TestNgTemplateTest">
                <methods>
                    <include name="t999_cleanup_delete_subscriber_from_cc"/>
                </methods>
            </class>
        </classes>
    </test>
	
	
	<test name="Create test user" parallel="false" preserve-order="true" enabled="false">
        <parameter name="xmlTemplateFile" value="TEST/Telia_Acquire_CITs/test-input-user.xml"/>
        <parameter name="testFilterLabel" value="SUAC_IMPORT"/>
        <classes>
            <class name="hr.altima.testng.test.template.TestNgTemplateTest">
                <methods>
                    <include name="t920_execute_soap_request"/>
                </methods>
            </class>
        </classes>
    </test>
	
	
	    <test name="Acquisition single request order as in input file" parallel="false" preserve-order="true" enabled="true">
        <parameter name="xmlTemplateFile" value="TEST/Telia_Acquire_CITs/test-input-acquire.xml"/>
        <parameter name="testFilterLabel" value="ACQUIRE_SINGLE"/>
        <classes>
            <class name="hr.altima.testng.test.template.TestNgTemplateTest">
                <methods>
                    <include name="t500_execute_acquire"/>
                </methods>
            </class>
        </classes>
    </test>

		
	<test name="Remove test user" parallel="false" preserve-order="true" enabled="false">
        <parameter name="xmlTemplateFile" value="TEST/Telia_Acquire_CITs/test-input-user.xml"/>
        <parameter name="testFilterLabel" value="SUAC_DELETE"/>
        <classes>
            <class name="hr.altima.testng.test.template.TestNgTemplateTest">
                <methods>
                    <include name="t999_cleanup_delete_subscriber_from_cc"/>
                </methods>
            </class>
        </classes>
    </test>
	
</suite>
