<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Allowances and one time fees test" parallel="false" preserve-order="true">

	<test name="Remove test user - old version" parallel="false" preserve-order="true" enabled="true">
        <parameter name="xmlTemplateFile" value="TEST/Telia_Allowances/test-input-user-old.xml"/>
        <parameter name="testFilterLabel" value="SUAC_DELETE"/>
        <classes>
            <class name="hr.altima.testng.test.template.TestNgTemplateTest">
                <methods>
                    <include name="t999_cleanup_delete_subscriber_from_cc"/>
                </methods>
            </class>
        </classes>
    </test>
	
	
	<test name="Create test user - old version" parallel="false" preserve-order="true" enabled="true">
        <parameter name="xmlTemplateFile" value="TEST/Telia_Allowances/test-input-user-old.xml"/>
        <parameter name="testFilterLabel" value="SUAC_IMPORT"/>
        <classes>
            <class name="hr.altima.testng.test.template.TestNgTemplateTest">
                <methods>
                    <include name="t920_execute_soap_request"/>
                </methods>
            </class>
        </classes>
    </test>

	<test name="Activate top up - old contract version" parallel="false" preserve-order="true" enabled="true">
        <parameter name="xmlTemplateFile" value="TEST/Telia_Allowances/test-input-onetime.xml"/>
        <parameter name="testFilterLabel" value="OTF_OLD"/>
        <classes>
            <class name="hr.altima.testng.test.template.TestNgTemplateTest">
                <methods>
                    <include name="t930_execute_charge"/>
                </methods>
            </class>
        </classes>
    </test>
	
	<test name="Allowance BIT creation - old contract version" parallel="false" preserve-order="true" enabled="true">
        <parameter name="xmlTemplateFile" value="TEST/Telia_Allowances/test-input-alw.xml"/>
        <parameter name="testFilterLabel" value="MALL_OLD"/>
        <classes>
            <class name="hr.altima.testng.test.template.TestNgTemplateTest">
                <methods>
                    <include name="t930_execute_charge"/>
                </methods>
            </class>
        </classes>
    </test>
	
	
</suite>
