<?xml version="1.0" encoding="UTF-8" ?>
<!-- $genInfo -->
<tns:testTemplate xmlns:tns="https://www.w3schools.com"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://www.w3schools.com ../common/xsd/test-inputs.xsd">
    <tns:header>
        <tns:constants>
            <tns:constant name="__META_TITLE__" constValue="Allowances tests - old contract version"/>
            <tns:constant name="__META_DESCRIPTION__" constValue="Allowances"/>
            <tns:constant name="_TEST_COMMON_DIR" constValue="TEST"/>
            <tns:constant name="_TEST_DIR" constValue="TEST/Telia_Allowances"/>
			<tns:constant name="CURRENT_YEAR" constValue="$DATE_TIME_NOW_items.Year"/>	
        </tns:constants>
		
        <tns:parameters>
            <tns:parameter name="sessionDefinitionFileList" type="string"/>
			<tns:parameter name="generateCit" type="string"/>
            <tns:parameter name="validateCitEnabled" type="string" defaultValue="false"/>
			<tns:parameter name="fwOnErrorFailTheTest" type="string" defaultValue="true"/>
			<tns:parameter name="onErrorFailTheTest" type="string" defaultValue="true"/>
			
			<tns:parameter name="ciPropertiesFile" type="string"/>
			<tns:parameter name="consumptionDate" type="date"/>
			<tns:parameter name="sapCcApi" type="string"/>
			<tns:parameter name="testExtension" type="string"/>

            <tns:parameter name="USER_SERVICE_ID" type="string"/>

			<!-- MALL input properties  -->
			<tns:parameter name="traffic_type" type="string"/>								
			<tns:parameter name="zone" type="string"/>
			<tns:parameter name="alw_unit" type="string"/>			
			<tns:parameter name="alw_qty" type="number"/>
			<tns:parameter name="product_type" type="string"/>	
			<tns:parameter name="product_code" type="string"/>			
			
			<!-- MALW output properties -->
			<tns:parameter name="bit_quantity" type="number"/>
			<tns:parameter name="bit_qty_unit" type="string"/>
			<tns:parameter name="bittype" type="string"/>
			<tns:parameter name="subprocess" type="string"/>			
			
		</tns:parameters>
    </tns:header>
	
	<tns:testData>
	
    	<tns:test>
            <tns:id>100</tns:id>
			<!-- MALL -->
			<tns:labels>MALL_OLD</tns:labels>

            <!-- path to the properties file -->
            <tns:parameter name="ciPropertiesFile" paramValue="$_TEST_COMMON_DIR/template/telia-mall-generic.properties"/>                      
			<tns:parameter name="sapCcApi" paramValue="WebService"/>
			<tns:parameter name="generateCit" paramValue="true"/>
			<tns:parameter name="testExtension" paramValue="$_TEST_DIR/ext/validate-alw-output.xml"/>
			<tns:parameter name="USER_SERVICE_ID" paramValue="9000000027"/>	
						
			<!-- MCIT input properties specific for test scenario -->
			<tns:parameter name="consumptionDate" paramValue="${CURRENT_YEAR}-06-19T10:26:46"/>	
			<tns:parameter name="alw_qty" paramValue="104857600"/>	
			<tns:parameter name="product_code" paramValue="MDP_100MB"/>	
			<!-- MOTF BIT Validation -->
			<tns:parameter name="bit_quantity" paramValue="100.000000"/>
			<tns:parameter name="bit_qty_unit" paramValue="MB"/>
			<tns:parameter name="bittype" paramValue="A100"/>
			<tns:parameter name="subprocess" paramValue="MOBB"/>
			
        </tns:test>
		
		<tns:test>
            <tns:id>200</tns:id>
			<!-- MALL -->
			<tns:labels>MALL_NEW</tns:labels>

            <!-- path to the properties file -->
            <tns:parameter name="ciPropertiesFile" paramValue="$_TEST_COMMON_DIR/template/telia-mall-generic.properties"/>                      
			<tns:parameter name="sapCcApi" paramValue="WebService"/>
			<tns:parameter name="generateCit" paramValue="true"/>
			<tns:parameter name="testExtension" paramValue="$_TEST_DIR/ext/validate-alw-output.xml"/>
			<tns:parameter name="USER_SERVICE_ID" paramValue="9000000028"/>	
						
			<!-- MCIT input properties specific for test scenario -->
			<tns:parameter name="consumptionDate" paramValue="${CURRENT_YEAR}-06-19T10:26:46"/>	
			<tns:parameter name="alw_qty" paramValue="1048576000"/>	
			<tns:parameter name="product_code" paramValue="MDP_1000MB"/>	
			<!-- MOTF BIT Validation -->
			<tns:parameter name="bit_quantity" paramValue="1000.000000"/>
			<tns:parameter name="bit_qty_unit" paramValue="MB"/>
			<tns:parameter name="bittype" paramValue="A100"/>
			<tns:parameter name="subprocess" paramValue="MOBC"/>
			
        </tns:test>
		
    </tns:testData>
</tns:testTemplate>
