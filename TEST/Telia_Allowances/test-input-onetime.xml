<?xml version="1.0" encoding="UTF-8" ?>
<!-- $genInfo -->
<tns:testTemplate xmlns:tns="https://www.w3schools.com"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://www.w3schools.com ../common/xsd/test-inputs.xsd">
    <tns:header>
        <tns:constants>
            <tns:constant name="__META_TITLE__" constValue="Allowances test"/>
            <tns:constant name="__META_DESCRIPTION__" constValue="Allowances"/>
            <tns:constant name="_TEST_COMMON_DIR" constValue="TEST"/>
            <tns:constant name="_TEST_DIR" constValue="${_TEST_COMMON_DIR}/Telia_Allowances"/> 
			
			<tns:constant name="CURRENT_YEAR" constValue="$DATE_TIME_NOW_items.Year"/>	
        </tns:constants>
        <tns:parameters>
            <tns:parameter name="wsRequestTemplate" type="string"/>
            <tns:parameter name="wsEndpointPropertyRef" type="string"/>
			<tns:parameter name="pcId" type="string"/>
			<tns:parameter name="subscriberAccountId" type="string"/>
			<tns:parameter name="ciPropertiesFile" type="string"/>
			<tns:parameter name="consumptionDate" type="date"/>
			<tns:parameter name="sapCcApi" type="string"/>
			<tns:parameter name="testExtension" type="string"/>
			<tns:parameter name="generateCit" type="string"/>
			
            <tns:parameter name="USER_SERVICE_ID" type="string"/>
					
			<!-- MOTE input properties -->
			<tns:parameter name="amount" type="number"/>	
			<tns:parameter name="product_id" type="string"/>	
			<tns:parameter name="product_code" type="string"/>	
			<tns:parameter name="request_type" type="string"/>								
			<tns:parameter name="reject_charge" type="string"/>
			<tns:parameter name="vat_included" type="string"/>						
			<tns:parameter name="product_type" type="string"/>	
			<tns:parameter name="request_source" type="string"/>
			<!-- MOTF output properties -->
			<tns:parameter name="bit_amount" type="number"/>			
			<tns:parameter name="bittype" type="string"/>
			<tns:parameter name="subprocess" type="string"/>
			<tns:parameter name="tax_code" type="string"/>

        </tns:parameters>
    </tns:header>
	
    <tns:testData>	
		<tns:test>
            <tns:id>100-TOPUP</tns:id>
			<!-- Topup -->
			<tns:labels>OTF_OLD</tns:labels>

            <!-- path to the properties file -->
            <tns:parameter name="ciPropertiesFile" paramValue="$_TEST_COMMON_DIR/template/telia-mote-generic.properties"/>                      
			<tns:parameter name="sapCcApi" paramValue="WebService"/>
			<tns:parameter name="generateCit" paramValue="true"/>
			<tns:parameter name="testExtension" paramValue="$_TEST_DIR/ext/validate-otf-output.xml"/>
			<tns:parameter name="USER_SERVICE_ID" paramValue="9000000027"/>	
						
			<!-- MCIT input properties specific for test scenario -->
			<tns:parameter name="consumptionDate" paramValue="${CURRENT_YEAR}-06-19T10:26:46"/>	
			<tns:parameter name="amount" paramValue="6"/>	
			<!-- MOTF BIT Validation -->
			<tns:parameter name="bit_amount" paramValue="6.000000"/>
			<tns:parameter name="bittype" paramValue="M300"/>
			<tns:parameter name="subprocess" paramValue="MOBB"/>
			<tns:parameter name="tax_code" paramValue="S1"/>
        </tns:test>
		
		<tns:test>
            <tns:id>100-TOPUP</tns:id>
			<!-- Topup -->
			<tns:labels>OTF_NEW</tns:labels>

            <!-- path to the properties file -->
            <tns:parameter name="ciPropertiesFile" paramValue="$_TEST_COMMON_DIR/template/telia-mote-generic.properties"/>                      
			<tns:parameter name="sapCcApi" paramValue="WebService"/>
			<tns:parameter name="generateCit" paramValue="true"/>
			<tns:parameter name="testExtension" paramValue="$_TEST_DIR/ext/validate-otf-output.xml"/>
			<tns:parameter name="USER_SERVICE_ID" paramValue="9000000028"/>	
						
			<!-- MCIT input properties specific for test scenario -->
			<tns:parameter name="consumptionDate" paramValue="${CURRENT_YEAR}-06-19T10:26:46"/>	
			<tns:parameter name="amount" paramValue="6"/>	
			<!-- MOTF BIT Validation -->
			<tns:parameter name="bit_amount" paramValue="6.000000"/>
			<tns:parameter name="bittype" paramValue="M300"/>
			<tns:parameter name="subprocess" paramValue="MOBC"/>
			<tns:parameter name="tax_code" paramValue="S1"/>
        </tns:test>
	
    </tns:testData>
</tns:testTemplate>
