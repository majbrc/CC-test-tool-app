			<tns:parameter name="zz_utr_id" paramValue="CHLIM"/>
			<tns:parameter name="allow_def_id" paramValue="AAA_AAAAA_AMW"/>
			<tns:parameter name="USER_SERVICE_ID" paramValue="9000000040"/>
        </tns:test>
		<tns:test>
            <tns:id>21</tns:id>
            <tns:labels>CHLIM_VALIDATE</tns:labels>
            <!-- path to the properties file --> 
            <tns:parameter name="testExtension" paramValue="$_TEST_DIR/ext/validate-utr.xml"/>
			<!--test-specific parameters-->
			<tns:parameter name="subscriberAccountId" paramValue="900000000000000000000000000028"/>
			<tns:parameter name="providerContractid" paramValue="90000000000000000034"/>
			<tns:parameter name="utrId" paramValue="CHLIM"/>
			<tns:parameter name="bucketValue" paramValue="100"/>		
