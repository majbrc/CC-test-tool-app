<?xml version="1.0" encoding="UTF-8"?>
      <!-- $genInfo -->
<tns:extension xmlns:tns="https://www.w3schools.com"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="https://www.w3schools.com ../templates/test-inputs/test-extension.xsd">
          <!-- this execution point is executed before session starts -->
      <tns:executionPoint id="chargeErrorHandlerCallback">
		 
         <tns:validations id="Verify error response">
             <tns:validate id="throwable" name="Validation of error response" enabled="true">
                 <tns:details>
                    <!-- value matches exactly expectedValue CASE SENSITIVE -->
                     <tns:detail name="CLASS" expectedValue="com.highdeal.pnr.hci.ForbiddenChargeException"/>
                     <!-- value matches exactly expectedValue CASE INSENSITIVE -->
                     <tns:detail name="MESSAGE" expectedValue="${errorMessage}">cmpRule:contains</tns:detail>
                     
                 </tns:details>
             </tns:validate>
         </tns:validations>
     </tns:executionPoint>
</tns:extension>