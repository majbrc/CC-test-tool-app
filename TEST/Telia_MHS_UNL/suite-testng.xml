        </classes>
    </test>
	
	<test name="Mobile messaging" parallel="false" preserve-order="true" enabled="true">
        <parameter name="xmlTemplateFile" value="TEST/Telia_MHS_UNL/test-input-01-msg.xml"/>
        <parameter name="testFilterLabel" value="MSG"/>
