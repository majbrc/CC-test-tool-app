    </test>
	
	<test name="Mobile data" parallel="false" preserve-order="true" enabled="false">
        <parameter name="xmlTemplateFile" value="TEST/Telia_MHS_UNL/test-input-01-data.xml"/>
        <parameter name="testFilterLabel" value="DATA"/>
        <classes>
            <class name="hr.altima.testng.test.template.TestNgTemplateTest">
