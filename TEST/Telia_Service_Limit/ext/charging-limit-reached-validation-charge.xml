<?xml version="1.0" encoding="UTF-8"?>
<!-- $genInfo ABC -->
<tns:extension xmlns:tns="https://www.w3schools.com"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://www.w3schools.com ../templates/test-inputs/test-extension.xsd">
    <!-- this execution point is executed before session starts -->
    
    <tns:executionPoint id="chargeErrorHandlerCallback">
         <tns:validations>
             <tns:validate id="throwable" name="Validate charge was rejected due to charging limit reached">
                 <tns:details>
                     <tns:detail name="CLASS" expectedValue="com.highdeal.pnr.hci.ForbiddenChargeException"/>
                     <tns:detail name="MESSAGE" expectedValue="CHARGING_LIMIT_REACHED">cmpRule:contains</tns:detail>
                 </tns:details>
             </tns:validate>
         </tns:validations>
     </tns:executionPoint>
</tns:extension>