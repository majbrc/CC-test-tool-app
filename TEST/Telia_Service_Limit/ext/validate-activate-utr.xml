<?xml version="1.0" encoding="UTF-8"?>
      <!-- $genInfo -->
<tns:extension xmlns:tns="https://www.w3schools.com"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="https://www.w3schools.com ../templates/test-inputs/test-extension.xsd">
          <!-- this execution point is executed AFTER the test  -->
          
		<tns:executionPoint id="AFTER">
		  <tns:actions>
         <tns:action id="chargingContractAllowanceFind" name="Find allowances on provider contract">
         <tns:property name="subscriberAccountId">${SUBSCRIBER_ACCOUNT_ID}</tns:property>
         <tns:property name="providerContractId">${PROVIDER_CONTRACT_ID}</tns:property>
         <tns:validations id="Verify allowance find response">
             <tns:validate id="allowanceFindResponse" name="Validation of allowance find response" enabled="true">
                 <tns:allowances>
                     <tns:allowance expectedNumber="1" name="find allowances in state active - there should be 1 of them">
						<tns:alwPlanId expectedValue="AP_UTR_T03"/>
                        <tns:alwStatus expectedValue="active"/>
						<tns:alwParameters>
                             <!-- parameter type can be: string | date | number -->
                             <tns:alwParameter name="PACK_SEL01" type="string" expectedValue="${utrId}"/>
                         </tns:alwParameters>
						 <tns:alwCounters>
                             <tns:alwCounter name="BUCKET_VALUE" expectedValue="${bucketValue}" enabled="true"/>
							 <tns:alwCounter name="BILLING_PERIOD_USAGE" expectedValue="${billingPeriodUsage}" enabled="true"/>
                         </tns:alwCounters>
                     </tns:allowance>
                     
                 </tns:allowances>
             </tns:validate>
			 
			 <tns:validate id="allowanceFindResponse" name="Validation of Service Limit allowance find response" enabled="true">
                 <tns:allowances>
                     <tns:allowance expectedNumber="1" name="Find Service Limit in state active - there should be 1 of them">
						<tns:alwPlanId expectedValue="AP_UTR_T03"/>
                        <tns:alwStatus expectedValue="active"/>
						<tns:alwParameters>
                             <!-- parameter type can be: string | date | number -->
                             <tns:alwParameter name="PACK_SEL01" type="string" expectedValue="SRVLIM"/>
                         </tns:alwParameters>
						 <tns:alwCounters>
                             <tns:alwCounter name="BUCKET_VALUE" expectedValue="300" enabled="true"/>
                         </tns:alwCounters>
                     </tns:allowance>
                     
                 </tns:allowances>
             </tns:validate>
         </tns:validations>
		 
		 </tns:action>
	 </tns:actions>
     </tns:executionPoint>
		
		
	
         
</tns:extension>