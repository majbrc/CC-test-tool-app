<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Service Limit Test Cases - B2C" parallel="false" preserve-order="true">

	<test name="Remove test user" parallel="false" preserve-order="true" enabled="false">
        <parameter name="xmlTemplateFile" value="TEST/Telia_Service_Limit/test-input-user.xml"/>
        <parameter name="testFilterLabel" value="SUAC_DELETE"/>
        <classes>
            <class name="hr.altima.testng.test.template.TestNgTemplateTest">
                <methods>
                    <include name="t999_cleanup_delete_subscriber_from_cc"/>
                </methods>
            </class>
        </classes>
    </test>
	
	
	<test name="Create test user" parallel="false" preserve-order="true" enabled="true">
        <parameter name="xmlTemplateFile" value="TEST/Telia_Service_Limit/test-input-user.xml"/>
        <parameter name="testFilterLabel" value="SUAC_IMPORT"/>
        <classes>
            <class name="hr.altima.testng.test.template.TestNgTemplateTest">
                <methods>
                    <include name="t920_execute_soap_request"/>
                </methods>
            </class>
        </classes>
    </test>
	
	<test name="Activation of Charging Limit, Validate SRVLIM" parallel="false" preserve-order="true" enabled="true">
        <parameter name="xmlTemplateFile" value="TEST/Telia_Service_Limit/test-input-utr.xml"/>
        <parameter name="testFilterLabel" value="CHLIM_ACTIVATE"/>
        <classes>
            <class name="hr.altima.testng.test.template.TestNgTemplateTest">
                <methods>
                    <include name="t930_execute_charge"/>
                </methods>
            </class>
        </classes>
    </test>

	
	<test name="Mobile messaging" parallel="false" preserve-order="true" enabled="true">
        <parameter name="xmlTemplateFile" value="TEST/Telia_Service_Limit/test-input-msg.xml"/>
        <parameter name="testFilterLabel" value="MSG"/>
        <classes>
            <class name="hr.altima.testng.test.template.TestNgTemplateTest">
                <methods>
                    <include name="t930_execute_charge"/>
                </methods>
            </class>
        </classes>
    </test>
	
	<test name="PGW 70% Charging Limit reached by a direct charge" parallel="false" preserve-order="true" enabled="false">
        <parameter name="xmlTemplateFile" value="TEST/Telia_Service_Limit/test-input-session.xml"/>
        <parameter name="testFilterLabel" value="PGW_70PCT_DIRECT"/>
        <classes>
            <class name="hr.altima.testng.test.template.TestNgTemplateTest">
                <methods>
                    <include name="t930_execute_charge"/>
                </methods>
            </class>
        </classes>
    </test>
	
	<test name="Change of Charging Limit so that 100% limit can be reached in a direct charge" parallel="false" preserve-order="true" enabled="false">
        <parameter name="xmlTemplateFile" value="TEST/Telia_Service_Limit/test-input-utr.xml"/>
        <parameter name="testFilterLabel" value="CHLIM_USAGE_SET_LIMIT_REACHED_TESTS"/>
        <classes>
            <class name="hr.altima.testng.test.template.TestNgTemplateTest">
                <methods>
                    <include name="t930_execute_charge"/>
                </methods>
            </class>
        </classes>
    </test>

		
	<test name="Remove test user" parallel="false" preserve-order="true" enabled="true">
        <parameter name="xmlTemplateFile" value="TEST/Telia_Service_Limit/test-input-user.xml"/>
        <parameter name="testFilterLabel" value="SUAC_DELETE"/>
        <classes>
            <class name="hr.altima.testng.test.template.TestNgTemplateTest">
                <methods>
                    <include name="t999_cleanup_delete_subscriber_from_cc"/>
                </methods>
            </class>
        </classes>
    </test>
	
</suite>
