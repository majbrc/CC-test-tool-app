<?xml version="1.0" encoding="UTF-8" ?>
<!-- $genInfo -->
<tns:testTemplate xmlns:tns="https://www.w3schools.com"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://www.w3schools.com ../common/xsd/test-inputs.xsd">
    <tns:header>
        <tns:constants>
            <tns:constant name="__META_TITLE__" constValue="Service Limit Tests"/>
            <tns:constant name="__META_DESCRIPTION__" constValue="Service limit"/>
            <tns:constant name="_TEST_COMMON_DIR" constValue="TEST"/>
            <tns:constant name="_TEST_DIR" constValue="TEST/Telia_Service_Limit"/>
            <tns:constant name="USER_SERVICE_ID" constValue="9000000025"/>
			
			<tns:constant name="SUBSCRIBER_ACCOUNT_ID" constValue="900000000000000000000000000009"/>
            <tns:constant name="PROVIDER_CONTRACT_ID" constValue="90000000000000000017"/>
			<tns:constant name="EVENT_DATE" constValue="2024-12-01T00:00:00"/>	

        </tns:constants>
		
        <tns:parameters>
            <tns:parameter name="sessionDefinitionFileList" type="string"/>
			<tns:parameter name="generateCit" type="string"/>
            <tns:parameter name="validateCitEnabled" type="string" defaultValue="false"/>
			<tns:parameter name="wsEndpointPropertyRef" type="string"/>
			<tns:parameter name="wsRequestTemplate" type="string"/>
			<tns:parameter name="pcId" type="string"/>
			<tns:parameter name="subscriberAccountId" type="string"/>
			
			<tns:parameter name="ciPropertiesFile" type="string"/>
			<tns:parameter name="consumptionDate" type="date"/>
			<tns:parameter name="sapCcApi" type="string"/>
			<tns:parameter name="testExtension" type="string"/>
			
			<tns:parameter name="rccLimit" type="number"/>
			<tns:parameter name="currentRccUsage" type="number"/>
			<tns:parameter name="billingPeriodUsage" type="number"/>		
			<tns:parameter name="bucketValue" type="number"/>
			<tns:parameter name="utrLimit" type="number"/>
			<tns:parameter name="zz_utr_id" type="string"/>
			<tns:parameter name="allow_def_id" type="string"/>
			<tns:parameter name="zz_ext_alw_id" type="string"/>
			<tns:parameter name="utrId" type="string"/>
			<tns:parameter name="validateNotificationEnabled" type="string" defaultValue="false"/>
		</tns:parameters>
    </tns:header>
	
	<tns:testData>		
		<tns:test>
            <tns:id>10</tns:id>
            <tns:labels>RCC_ACTIVATE</tns:labels>
            <!-- path to the properties file -->
            <tns:parameter name="ciPropertiesFile" paramValue="$_TEST_COMMON_DIR/template/telia-activate-utr.properties"/>
            <!-- consumption date for charge/blankCharge request -->
            <tns:parameter name="consumptionDate" paramValue="$EVENT_DATE"/>
			<tns:parameter name="sapCcApi" paramValue="WebService"/>
			<tns:parameter name="testExtension" paramValue="$_TEST_DIR/ext/validate-utr.xml"/>
			<tns:parameter name="utrLimit" paramValue="49.59"/>
			<tns:parameter name="allow_def_id" paramValue="AAA_AAAAA_ANK"/>
			<tns:parameter name="zz_utr_id" paramValue="RCC"/>
			<!-- validation of allowance -->
			<tns:parameter name="utrId" paramValue="RCC"/>
			<tns:parameter name="billingPeriodUsage" paramValue="0"/>
			<tns:parameter name="bucketValue" paramValue="49.59"/>
			
        </tns:test>
	
	<tns:test>
            <tns:id>11</tns:id>
            <tns:labels>RCC_USAGE_CHANGE_SMALL_QUOTA</tns:labels>
            <!-- path to the properties file -->
            <tns:parameter name="ciPropertiesFile" paramValue="$_TEST_COMMON_DIR/template/telia-change-rcc-usage.properties"/>
			<tns:parameter name="sapCcApi" paramValue="WebService"/>
			<tns:parameter name="testExtension" paramValue="$_TEST_DIR/ext/validate-rcc.xml"/>
			<tns:parameter name="generateCit" paramValue="false"/>
            <!-- consumption date for charge/blankCharge request -->
			<tns:parameter name="currentRccUsage" paramValue="49.56"/>
            <tns:parameter name="consumptionDate" paramValue="$EVENT_DATE"/>
			<tns:parameter name="zz_ext_alw_id" paramValue="AAA_AAAAA_ANK"/>
			<!-- Validation -->
			<tns:parameter name="utrId" paramValue="RCC"/>
			<tns:parameter name="billingPeriodUsage" paramValue="49.56"/>
			<tns:parameter name="bucketValue" paramValue="49.59"/>
        </tns:test>
		
		<tns:test>
            <tns:id>20</tns:id>
            <tns:labels>CHLIM_ACTIVATE</tns:labels>
            <!-- path to the properties file -->
            <tns:parameter name="ciPropertiesFile" paramValue="$_TEST_COMMON_DIR/template/telia-activate-utr.properties"/>
			<tns:parameter name="sapCcApi" paramValue="WebService"/>
			<tns:parameter name="testExtension" paramValue="$_TEST_DIR/ext/validate-utr.xml"/>
            <!-- consumption date for charge/blankCharge request -->
            <tns:parameter name="consumptionDate" paramValue="$EVENT_DATE"/>
			<tns:parameter name="utrLimit" paramValue="300"/>
			<tns:parameter name="zz_utr_id" paramValue="CHLIM"/>
			<tns:parameter name="allow_def_id" paramValue="AAA_AAAAA_AMW"/>
			<!-- Validation -->
			<tns:parameter name="utrId" paramValue="CHLIM"/>
			<tns:parameter name="billingPeriodUsage" paramValue="0"/>
			<tns:parameter name="bucketValue" paramValue="300"/>
        </tns:test>
		
	
    </tns:testData>
</tns:testTemplate>
