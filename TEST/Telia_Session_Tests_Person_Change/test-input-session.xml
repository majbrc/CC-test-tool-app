<?xml version="1.0" encoding="UTF-8" ?>
<!-- $genInfo -->
<tns:testTemplate xmlns:tns="https://www.w3schools.com"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://www.w3schools.com ../common/xsd/test-inputs.xsd">
    <tns:header>
        <tns:constants>
            <tns:constant name="__META_TITLE__" constValue="Overspending tests"/>
            <tns:constant name="__META_DESCRIPTION__" constValue="Overspending"/>
            <tns:constant name="_TEST_COMMON_DIR" constValue="TEST"/>
            <tns:constant name="_TEST_DIR" constValue="TEST/Telia_Session_Tests_Person_Change"/>
            <tns:constant name="USER_SERVICE_ID" constValue="90000000004"/>
			<!-- extract current year -->
			<tns:constant name="CURRENT_YEAR" constValue="$DATE_TIME_NOW_items.Year"/>		
			
			<tns:constant name="EVENT_DATE" constValue="${CURRENT_YEAR}-10-19T10:05:41"/>
        </tns:constants>
		
        <tns:parameters>
            <tns:parameter name="sessionDefinitionFileList" type="string"/>
			<tns:parameter name="generateCit" type="string"/>
            <tns:parameter name="validateCitEnabled" type="string" defaultValue="false"/>
			<tns:parameter name="fwOnErrorFailTheTest" type="string" defaultValue="false"/>
			
			<tns:parameter name="ciPropertiesFile" type="string"/>
			<tns:parameter name="consumptionDate" type="date"/>
			<tns:parameter name="sapCcApi" type="string"/>
			<tns:parameter name="testExtension" type="string"/>
			
		</tns:parameters>
    </tns:header>
	
	<tns:testData>
        <tns:test>
            <tns:id>1</tns:id>
            <tns:labels>PERSON_CHANGE_PAYG_DATA</tns:labels>
            <tns:parameter name="sessionDefinitionFileList" paramValue="${_TEST_DIR}/templates/01.telia.test.data.ini"/>
			<!-- <tns:parameter name="testExtension" paramValue="$_TEST_DIR/ext/overspending-validation.xml"/>-->
			<tns:parameter name="generateCit" paramValue="false"/>
			<tns:parameter name="validateCitEnabled" paramValue="false"/>
			
			
        </tns:test>

		
    </tns:testData>
</tns:testTemplate>
