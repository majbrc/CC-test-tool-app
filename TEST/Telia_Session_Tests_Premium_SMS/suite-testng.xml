<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Premium SMS charging" parallel="false" preserve-order="true">

	<test name="Remove test user" parallel="false" preserve-order="true" enabled="true">
        <parameter name="xmlTemplateFile" value="TEST/Telia_Session_Tests_Premium_SMS/test-input-user.xml"/>
        <parameter name="testFilterLabel" value="SUAC_DELETE"/>
        <classes>
            <class name="hr.altima.testng.test.template.TestNgTemplateTest">
                <methods>
                    <include name="t999_cleanup_delete_subscriber_from_cc"/>
                </methods>
            </class>
        </classes>
    </test>
	
	
	<test name="Create test user" parallel="false" preserve-order="true" enabled="true">
        <parameter name="xmlTemplateFile" value="TEST/Telia_Session_Tests_Premium_SMS/test-input-user.xml"/>
        <parameter name="testFilterLabel" value="SUAC_IMPORT"/>
        <classes>
            <class name="hr.altima.testng.test.template.TestNgTemplateTest">
                <methods>
                    <include name="t920_execute_soap_request"/>
                </methods>
            </class>
        </classes>
    </test>
	
	<test name="Activation of Charging Limit" parallel="false" preserve-order="true" enabled="true">
        <parameter name="xmlTemplateFile" value="TEST/Telia_Session_Tests_Premium_SMS/test-input-utr.xml"/>
        <parameter name="testFilterLabel" value="CHLIM_ACTIVATE"/>
        <classes>
            <class name="hr.altima.testng.test.template.TestNgTemplateTest">
                <methods>
                    <include name="t930_execute_charge"/>
                </methods>
            </class>
        </classes>
    </test>
	
		<test name="Data session charged between billing cycles" parallel="false" preserve-order="true" enabled="false">
        <parameter name="xmlTemplateFile" value="TEST/Telia_Session_Tests_Premium_SMS/test-input-session.xml"/>
        <parameter name="testFilterLabel" value="DATA_SESSION_BETWEEN_CYCLES"/>
        <classes>
            <class name="hr.altima.testng.test.template.TestNgTemplateTest">
                <methods>
                    <include name="t900_execute_charging_session"/>
                </methods>
            </class>
        </classes>
    </test>
	
	
	<test name="Change of Charging Limit so it is available" parallel="false" preserve-order="true" enabled="false">
        <parameter name="xmlTemplateFile" value="TEST/Telia_Session_Tests_Premium_SMS/test-input-utr.xml"/>
        <parameter name="testFilterLabel" value="CHLIM_FUNDS_AVAILABLE"/>
        <classes>
            <class name="hr.altima.testng.test.template.TestNgTemplateTest">
                <methods>
                    <include name="t930_execute_charge"/>
                </methods>
            </class>
        </classes>
    </test>

	<test name="Premium SMS from Opaali charges" parallel="false" preserve-order="true" enabled="true">
        <parameter name="xmlTemplateFile" value="TEST/Telia_Session_Tests_Premium_SMS/test-input-session.xml"/>
        <parameter name="testFilterLabel" value="CHLIM_PREMIUM_SMS_BETWEEN_CYCLES"/>
        <classes>
            <class name="hr.altima.testng.test.template.TestNgTemplateTest">
                <methods>
                    <include name="t900_execute_charging_session"/>
                </methods>
            </class>
        </classes>
    </test>
	
	
	<test name="Change of Charging Limit so it is unavailable" parallel="false" preserve-order="true" enabled="false">
        <parameter name="xmlTemplateFile" value="TEST/Telia_Session_Tests_Premium_SMS/test-input-utr.xml"/>
        <parameter name="testFilterLabel" value="CHLIM_FUNDS_UNAVAILABLE"/>
        <classes>
            <class name="hr.altima.testng.test.template.TestNgTemplateTest">
                <methods>
                    <include name="t930_execute_charge"/>
                </methods>
            </class>
        </classes>
    </test>
	
	

	<test name="Premium SMS from Opaali charge - rejected" parallel="false" preserve-order="true" enabled="false">
        <parameter name="xmlTemplateFile" value="TEST/Telia_Session_Tests_Premium_SMS/test-input-session.xml"/>
        <parameter name="testFilterLabel" value="CHLIM_PREMIUM_SMS_REJECTED"/>
        <classes>
            <class name="hr.altima.testng.test.template.TestNgTemplateTest">
                <methods>
                    <include name="t900_execute_charging_session"/>
                </methods>
            </class>
        </classes>
    </test>
	
	
		
	<test name="Remove test user" parallel="false" preserve-order="true" enabled="false">
        <parameter name="xmlTemplateFile" value="TEST/Telia_Session_Tests_Premium_SMS/test-input-user.xml"/>
        <parameter name="testFilterLabel" value="SUAC_DELETE"/>
        <classes>
            <class name="hr.altima.testng.test.template.TestNgTemplateTest">
                <methods>
                    <include name="t999_cleanup_delete_subscriber_from_cc"/>
                </methods>
            </class>
        </classes>
    </test>
	
</suite>
