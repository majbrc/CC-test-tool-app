<?xml version="1.0" encoding="UTF-8"?>
<!-- $genInfo ABC -->
<tns:extension xmlns:tns="https://www.w3schools.com"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://www.w3schools.com ../templates/test-inputs/test-extension.xsd">
    <!-- this execution point is executed before session starts -->
    <tns:executionPoint id="beforeSessionStartRateCallback">
        <tns:actions>
            <tns:action id="setMainBalance" name="set prepaid balance" enabled="${setMainBalanceEnabled}">
                <tns:property name="msisdn">${MSISDN}</tns:property>
                <tns:property name="consumptionDate">2022-11-07T09:00:00</tns:property>
                <tns:property name="amount">${mainBalanceSetAmount}</tns:property>
            </tns:action>
            <tns:action id="setDefaultMonetaryCounter" name="set default monetary counter to zero" enabled="false">
                <tns:property name="msisdn">$MSISDN</tns:property>
                <tns:property name="consumptionDate">2022-11-07T09:00:00</tns:property>
                <tns:property name="amount">1</tns:property>
            </tns:action>
        </tns:actions>
    </tns:executionPoint>

    <tns:executionPoint id="afterSessionStartRateCallback" enabled="true">
        <tns:validations>
            <tns:validate id="startRateResult" name="validate start rate result">
                <tns:amountToReserve>1.545</tns:amountToReserve>
                <tns:details>
                     <tns:detail name="computed.biBasEvtTyp" expectedValue="203"/>
                 </tns:details>
            </tns:validate>
        </tns:validations>
    </tns:executionPoint>

    <tns:executionPoint id="afterSessionUpdateRateCallback" enabled="true">
        <tns:validations>
            <tns:validate id="updateRateResult-cfm-1" name="validate update rate confirmation result">
                <tns:amount>1.547</tns:amount>
                <tns:details>
                     <tns:detail name="computed.foNumberS" expectedValue="1.545"/>
                 </tns:details>
            </tns:validate>
            <tns:validate id="updateRateResult-rsv-1" name="validate update rate reservation result">
                <tns:amount>1.53</tns:amount>
                <tns:details>
                     <tns:detail name="computed.foNumberS" expectedValue="1.53"/>
                 </tns:details>
            </tns:validate>
            <tns:validate id="updateRateResult-cfm-2" name="validate update rate confirmation result">
                <tns:amount>0.75</tns:amount>
                <tns:details>
                     <tns:detail name="computed.foNumberS" expectedValue="0.75"/>
                 </tns:details>
            </tns:validate>
            <tns:validate id="updateRateResult-rsv-2" name="validate update rate reservation result">
                <tns:amount>1.53</tns:amount>
                <tns:details>
                     <tns:detail name="computed.foNumberS" expectedValue="1.53"/>
                 </tns:details>
            </tns:validate>
        </tns:validations>
    </tns:executionPoint>
    
    <tns:executionPoint id="afterSessionStopRateCallback" enabled="true">
        <tns:validations>
            <tns:validate id="stopRateResult" name="validate amount charged for session">
                <tns:accumulatedAmount>3.72</tns:accumulatedAmount>
            </tns:validate>
        </tns:validations>
    </tns:executionPoint>
    
    <tns:executionPoint id="AFTER" >
         <tns:validations>
             <tns:validate id="chargedItems" name="validate CIT" enabled="${validateCitEnabled}">
                 <tns:cits>
                     <tns:cit name="First CIT validation" expectedNumber="1" classId="HMT0_HTM01" enabled="true">
                         <tns:citParameter name="BITTYPE" expectedValue="DM00" enabled="true"/>
                         <tns:citParameter name="ZZ_ZON_CUG_ID" expectedValue="0" enabled="true"/>
                         <tns:citParameter name="BIT_AMOUNT" expectedValue="3.720000" enabled="true"/>
                     </tns:cit>
                 </tns:cits>
             </tns:validate>
         </tns:validations>
     </tns:executionPoint>
</tns:extension>