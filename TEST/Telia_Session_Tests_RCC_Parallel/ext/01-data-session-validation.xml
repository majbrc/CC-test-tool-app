<?xml version="1.0" encoding="UTF-8"?>
<!-- $genInfo ABC -->
<tns:extension xmlns:tns="https://www.w3schools.com"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://www.w3schools.com ../templates/test-inputs/test-extension.xsd">
    <!-- this execution point is executed before session starts -->
    
    <tns:executionPoint id="afterSessionStartRateCallback">
        <tns:validations>
            <tns:validate id="startRateResult" name="validate start rate result" enabled="${startRateValidationEnabled}">
                <tns:amountToReserve>${startRate_amountToReserve}</tns:amountToReserve>
                <tns:details>
                     <tns:detail name="computed.CC_QUOTA" expectedValue="${startRate_cc_quota}"/>
					 <tns:detail name="computed.RESERVED_LIMIT" expectedValue="${startRate_reserved_limit}"/>
					 <tns:detail name="computed.RESERVED_QUOTA" expectedValue="${startRate_reserved_quota}"/>
					 <tns:detail name="computed.REMAINING_LIMIT" expectedValue="${startRate_remaining_limit}"/>
                 </tns:details>
            </tns:validate>
        </tns:validations>
    </tns:executionPoint>

    <tns:executionPoint id="afterSessionUpdateRateCallback">
        <tns:validations>
            <tns:validate id="updateRateResult-cfm-1" name="Validate 1st update rate confirmation result" enabled="${update1ValidationEnabled}">
                <tns:amount>${updateRate1_cfm_amount}</tns:amount>
                <tns:accumulatedAmount>${updateRate1_cfm_accumulatedAmount}</tns:accumulatedAmount>
                <tns:details>
                     <tns:detail name="computed.CC_QUOTA" expectedValue="${updateRate1_cfm_cc_quota}"/>
					 <tns:detail name="computed.REMAINING_LIMIT" expectedValue="${updateRate1_cfm_remaining_limit}"/>
					 <tns:detail name="computed.RESERVED_LIMIT" expectedValue="${updateRate1_cfm_reserved_limit}"/>
					 <tns:detail name="computed.RESERVED_QUOTA" expectedValue="${updateRate1_cfm_reserved_quota}"/>
                 </tns:details>
            </tns:validate>
            <tns:validate id="updateRateResult-rsv-1" name="Validate 1st update rate reservation result" enabled="${update1ValidationEnabled}">
                <tns:amount>${updateRate1_rsv_amountToReserve}</tns:amount>
                <tns:details>
                     <tns:detail name="computed.CC_QUOTA" expectedValue="${updateRate1_rsv_cc_quota}"/>
					 <tns:detail name="computed.RESERVED_QUOTA" expectedValue="${updateRate1_rsv_reserved_quota}"/>
					 <tns:detail name="computed.REMAINING_LIMIT" expectedValue="${updateRate1_rsv_remaining_limit}"/>					 
                 </tns:details>
            </tns:validate>
			<tns:validate id="updateRateResult-cfm-2" name="Validate 2nd update rate confirmation result" enabled="${update2ValidationEnabled}">
                <tns:amount>${updateRate2_cfm_amount}</tns:amount>
                <tns:accumulatedAmount>${updateRate2_cfm_accumulatedAmount}</tns:accumulatedAmount>
                <tns:details>
                     <tns:detail name="computed.CC_QUOTA" expectedValue="${updateRate2_cfm_cc_quota}"/>
					 <tns:detail name="computed.REMAINING_LIMIT" expectedValue="${updateRate2_cfm_remaining_limit}"/>
					 <tns:detail name="computed.RESERVED_LIMIT" expectedValue="${updateRate2_cfm_reserved_limit}"/>
					 <tns:detail name="computed.RESERVED_QUOTA" expectedValue="${updateRate2_cfm_reserved_quota}"/>
                 </tns:details>
            </tns:validate>
            <tns:validate id="updateRateResult-rsv-2" name="Validate 2nd update rate reservation result" enabled="${update2ValidationEnabled}">
                <tns:amount>${updateRate2_rsv_amountToReserve}</tns:amount>
                <tns:details>
                     <tns:detail name="computed.CC_QUOTA" expectedValue="${updateRate2_rsv_cc_quota}"/>
					 <tns:detail name="computed.RESERVED_QUOTA" expectedValue="${updateRate2_rsv_reserved_quota}"/>
					 <tns:detail name="computed.REMAINING_LIMIT" expectedValue="${updateRate2_rsv_remaining_limit}"/>
                 </tns:details>
            </tns:validate>
			<tns:validate id="updateRateResult-cfm" name="validate all update rate confirmation results" enabled="${updateCfmValidationEnabled}">
                <tns:details>
                     <tns:detail name="computed.LIMIT_ID" expectedValue="${updateRate_cfm_limit_id}"/>
                 </tns:details>
            </tns:validate>
            <tns:validate id="updateRateResult-rsv" name="validate all update rate reservation results" enabled="${updateRsvValidationEnabled}">
                <tns:details>
                     <tns:detail name="computed.LIMIT_ID" expectedValue="${updateRate_rsv_limit_id}"/>
                 </tns:details>
            </tns:validate>
        </tns:validations>
    </tns:executionPoint>
    
    <tns:executionPoint id="afterSessionStopRateCallback">
        <tns:validations>
            <tns:validate id="stopRateResult" name="validate amount charged for session" enabled="${stopRateValidationEnabled}">
                <tns:accumulatedAmount>${stopRate_accumulatedAmount}</tns:accumulatedAmount>
				<tns:details>
					<tns:detail name="computed.CC_QUOTA" expectedValue="${stopRate_cc_quota}"/>
					<tns:detail name="computed.REMAINING_LIMIT" expectedValue="${stopRate_remaining_limit}"/>
				</tns:details>
            </tns:validate>
        </tns:validations>
    </tns:executionPoint>
    
    <tns:executionPoint id="AFTER" >
         <tns:validations>
             <tns:validate id="chargedItems" name="validate CIT" enabled="${validateCitEnabled}">
                 <tns:cits>
                     <tns:cit name="Session CIT" expectedNumber="1" classId="MUSG" enabled="true">
                         <tns:citParameter name="BITTYPE" expectedValue="M300" enabled="true"/>
                         <tns:citParameter name="BIT_CURR" expectedValue="EUR" enabled="true"/>
                         <tns:citParameter name="BIT_AMOUNT" expectedValue="${bit_amount}" enabled="true"/>
						 <tns:citParameter name="SUBPROCESS" expectedValue="MOBB" enabled="true"/>
						 <tns:citParameter name="BIT_QUANTITY" expectedValue="${bit_quantity}" enabled="true"/>
						 <tns:citParameter name="ZZ_EVENT_USP" expectedValue="${zz_event_usp}" enabled="true"/>
						 <tns:citParameter name="ZZ_DOWNLOAD_VAL" expectedValue="${zz_download_val}" enabled="true"/>
						 <tns:citParameter name="ZZ_UPLOAD_VAL" expectedValue="${zz_upload_val}" enabled="true"/>
						 <tns:citParameter name="ZZ_CH_UOM" expectedValue="${zz_ch_uom}" enabled="true"/>
						 <tns:citParameter name="ZZ_CH_QUANTITY" expectedValue="${zz_ch_quantity}" enabled="true"/>
						 <tns:citParameter name="ZZ_LOG_CHG_ID" expectedValue="${zz_log_chg_id}" enabled="true"/>
						 <tns:citParameter name="ZZ_LOG_CHG_QTY" expectedValue="${zz_log_chg_qty}" enabled="true"/>
						 <tns:citParameter name="ZZ_LOG_FULL_PRC" expectedValue="${zz_log_full_prc}" enabled="true"/>
						 <tns:citParameter name="ZZ_ORIG_COUNTRY" expectedValue="${zz_orig_country}" enabled="true"/>
						 <tns:citParameter name="ZZ_ORIG_DSCR" expectedValue="${zz_orig_dscr}" enabled="true"/>
						 <tns:citParameter name="ZZ_ORIG_ZONE" expectedValue="${zz_orig_zone}" enabled="true"/>
						 <tns:citParameter name="ZZ_ORIG_ZON_SCH" expectedValue="${zz_orig_zon_sch}" enabled="true"/>
						 <tns:citParameter name="ZZ_PRC_GROUP" expectedValue="${zz_prc_group}" enabled="true"/>
						 <tns:citParameter name="ZZ_PRICE_ID" expectedValue="${zz_price_id}" enabled="true"/>
						 <tns:citParameter name="ZZ_ROAM_PRC_TYPE" expectedValue="${zz_roam_prc_type}" enabled="true"/>
						 <tns:citParameter name="ZZ_SOURCE_ID" expectedValue="MZ" enabled="true"/>
						 <tns:citParameter name="ZZ_TARIFF" expectedValue="${zz_tariff}" enabled="true"/>
						 <tns:citParameter name="ZZ_DOMINTROAM" expectedValue="${zz_domintroam}" enabled="true"/>
						 <tns:citParameter name="ZZ_DET_INV_DIGIT" expectedValue="${zz_det_inv_digit}" enabled="true"/>
						 <tns:citParameter name="POSTREL" expectedValue="true" enabled="true"/>
						 <tns:citParameter name="PRINTREL" expectedValue="${printrel}" enabled="true"/>
                     </tns:cit>
                 </tns:cits>
             </tns:validate>
         </tns:validations>
     </tns:executionPoint>
</tns:extension>