<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="RCC Test Cases" parallel="false" preserve-order="true">

	<test name="Remove test user" parallel="false" preserve-order="true" enabled="false">
        <parameter name="xmlTemplateFile" value="TEST/Telia_Session_Tests_RCC_Parallel/test-input-user.xml"/>
        <parameter name="testFilterLabel" value="SUAC_DELETE"/>
        <classes>
            <class name="hr.altima.testng.test.template.TestNgTemplateTest">
                <methods>
                    <include name="t999_cleanup_delete_subscriber_from_cc"/>
                </methods>
            </class>
        </classes>
    </test>
	
	
	<test name="Create test user" parallel="false" preserve-order="true" enabled="true">
        <parameter name="xmlTemplateFile" value="TEST/Telia_Session_Tests_RCC_Parallel/test-input-user.xml"/>
        <parameter name="testFilterLabel" value="SUAC_IMPORT"/>
        <classes>
            <class name="hr.altima.testng.test.template.TestNgTemplateTest">
                <methods>
                    <include name="t920_execute_soap_request"/>
                </methods>
            </class>
        </classes>
    </test>
	
	<test name="Activation of RCC" parallel="false" preserve-order="true" enabled="true">
        <parameter name="xmlTemplateFile" value="TEST/Telia_Session_Tests_RCC_Parallel/test-input-rcc.xml"/>
        <parameter name="testFilterLabel" value="RCC_ACTIVATE"/>
        <classes>
            <class name="hr.altima.testng.test.template.TestNgTemplateTest">
                <methods>
                    <include name="t930_execute_charge"/>
                </methods>
            </class>
        </classes>
    </test>
	
	
	<test name="Change RCC usage counter so that it is below 80% RCC limit" parallel="false" preserve-order="true" enabled="true">
        <parameter name="xmlTemplateFile" value="TEST/Telia_Session_Tests_RCC_Parallel/test-input-rcc.xml"/>
        <parameter name="testFilterLabel" value="RCC_USAGE_CHANGE_80PCT_NOTIF"/>
        <classes>
            <class name="hr.altima.testng.test.template.TestNgTemplateTest">
                <methods>
                    <include name="t930_execute_charge"/>
                </methods>
            </class>
        </classes>
    </test>
	
	<test name="Charge data roaming in session, trigger 80% RCC limit notification, multisession" parallel="false" preserve-order="true" enabled="true">
        <parameter name="xmlTemplateFile" value="TEST/Telia_Session_Tests_RCC_Parallel/test-input-session.xml"/>
        <parameter name="testFilterLabel" value="TELIA_DATA_ROAM_80PCT_NOTIF_MULTISESSION"/>
        <classes>
            <class name="hr.altima.testng.test.template.TestNgTemplateTest">
                <methods>
                    <include name="t900_execute_charging_session"/>
                </methods>
            </class>
        </classes>
	</test>
	
	
	<test name="Remove test user" parallel="false" preserve-order="true" enabled="true">
        <parameter name="xmlTemplateFile" value="TEST/Telia_Session_Tests_RCC_Parallel/test-input-user.xml"/>
        <parameter name="testFilterLabel" value="SUAC_DELETE"/>
        <classes>
            <class name="hr.altima.testng.test.template.TestNgTemplateTest">
                <methods>
                    <include name="t999_cleanup_delete_subscriber_from_cc"/>
                </methods>
            </class>
        </classes>
    </test>
	
</suite>
