<?xml version="1.0" encoding="UTF-8"?>
      <!-- $genInfo -->
      <tns:extension xmlns:tns="https://www.w3schools.com"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="https://www.w3schools.com ../templates/test-inputs/test-extension.xsd">
          <!-- this execution point is executed before session starts -->
          <tns:executionPoint id="AFTER" >
         <tns:validations>
             <tns:validate id="chargedItems" name="validate TUSE charged item" enabled="true">
                 <tns:cits>
                     <tns:cit name="Charged item validation" expectedNumber="1" classId="TUSE" enabled="true">
                         <tns:citParameter name="BIT_AMOUNT" expectedValue="${bit_amount}" enabled="${bit_amount_present}"/>						 
						 <tns:citParameter name="BIT_QUANTITY" expectedValue="${bit_quantity}" enabled="true"/>						 
						 <tns:citParameter name="BITDATE_FROM" expectedValue="${bitdate_from}" enabled="false"/>
						 <tns:citParameter name="BITDATE_TO" expectedValue="${bitdate_to}" enabled="false"/>						 
						 <tns:citParameter name="ZZCRM_CALL_TYPE" expectedValue="${zzcrm_call_type}" enabled="true"/>
						 <tns:citParameter name="ZZCRM_CALL_DEST" expectedValue="$(zzcrm_call_dest)" enabled="false"/>
						 <tns:citParameter name="ZZCRM_REF4" expectedValue="${zzcrm_ref4}" enabled="true"/>						 
                     </tns:cit>
                 </tns:cits>
			 </tns:validate>
         </tns:validations>
     </tns:executionPoint>
</tns:extension>