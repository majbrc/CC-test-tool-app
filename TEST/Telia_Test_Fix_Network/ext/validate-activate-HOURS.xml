<?xml version="1.0" encoding="UTF-8"?>
<!-- $genInfo -->
<tns:extension xmlns:tns="https://www.w3schools.com"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="https://www.w3schools.com ../../../common/xsd/test-extension.xsd">

    <tns:executionPoint id="BEFORE">
        <tns:actions>
            <tns:action id="activateProviderContract" name="activate provider contract">
                <tns:property name="serviceProvider">O2C</tns:property>
                <tns:property name="subscriberAccountId">$SUBSCRIBER_ACCOUNT_ID</tns:property>
                <tns:property name="activateToDate">$activateToDate</tns:property>
            </tns:action>
        </tns:actions>
    </tns:executionPoint>
    <tns:executionPoint id="AFTER">
        <tns:actions>
            <tns:action id="chargingContractAllowanceFind">
                <tns:property name="subscriberAccountId">$SUBSCRIBER_ACCOUNT_ID</tns:property>
                <tns:property name="providerContractId">$PROVIDER_CONTRACT_ID</tns:property>
                <tns:validations id="Verify allowance find response">
                    <tns:validate id="allowanceFindResponse" name="Validation of allowance find response">
                        <tns:allowances>

                            <tns:allowance expectedNumber="1" name="validate PEAK allowance">
                                <tns:alwPlanId expectedValue="AP_TEO_NON_MONETARY_USAGE_V1.2"/>
								<tns:alwStatus expectedValue="active"/>
                                <tns:alwParameters>
                                    <tns:alwParameter name="TIME_ID" expectedValue="P"/>
                                    <tns:alwParameter name="ALLOWANCE_TYPE" expectedValue="ENTITLEMENT"/>
                                </tns:alwParameters>
                                <tns:alwCounters>
                                    <tns:alwCounter name="BUCKET_VALUE" expectedValue="36000"/>
                                </tns:alwCounters>
                            </tns:allowance>

							<tns:allowance expectedNumber="0" name="validate OFFPEAK allowance">
                                <tns:alwPlanId expectedValue="AP_TEO_NON_MONETARY_USAGE_V1.2"/>
                                <tns:alwStatus expectedValue="active"/>
                                <tns:alwParameters>
                                    <tns:alwParameter name="TIME_ID" expectedValue="O"/>
                                    <tns:alwParameter name="ALLOWANCE_TYPE" expectedValue="ENTITLEMENT"/>
                                </tns:alwParameters>
                                <tns:alwCounters>
                                    <tns:alwCounter name="BUCKET_VALUE" expectedValue="0"/>
                                </tns:alwCounters>
                            </tns:allowance>
                            
							<tns:allowance expectedNumber="0" name="validate billing period usage">
                                <tns:alwPlanId expectedValue="AP_TEO_BILLING_PERIOD_USAGE"/>
								<tns:alwStatus expectedValue="active"/>
                                <tns:alwParameters>                                    
                                    <tns:alwParameter name="ALLOWANCE_TYPE" expectedValue="CURRENT_BILLING_PERIOD_USAGE"/>
                                </tns:alwParameters>
                                <tns:alwCounters>
                                    <tns:alwCounter name="BILLING_PERIOD_USAGE" expectedValue="0"/>
                                </tns:alwCounters>
                            </tns:allowance>

                        </tns:allowances>
                    </tns:validate>
                </tns:validations>
            </tns:action>
        </tns:actions>
    </tns:executionPoint>
</tns:extension>