<?xml version="1.0" encoding="UTF-8" ?>
<!-- $genInfo -->
<tns:testTemplate xmlns:tns="https://www.w3schools.com"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://www.w3schools.com ../common/xsd/test-inputs.xsd">
    <tns:header>
        <tns:constants>
            <tns:constant name="__META_TITLE__" constValue="Specific contract test"/>
            <tns:constant name="__META_DESCRIPTION__" constValue="Test inputs for voice usage scenarios"/>
            <tns:constant name="_TEST_COMMON_DIR" constValue="TEST"/>
            <tns:constant name="_TEST_DIR" constValue="${_TEST_COMMON_DIR}/Telia_Test_Group_01"/>
			<!-- subscriber ID -->
			<tns:constant name="USER_SERVICE_ID" constValue="9000000012"/>	  
			<!-- extract current year -->
			<tns:constant name="CURRENT_YEAR" constValue="$DATE_TIME_NOW_items.Year"/>		
			
        </tns:constants>
        <tns:parameters>
            <tns:parameter name="wsRequestTemplate" type="string"/>
            <tns:parameter name="wsEndpointPropertyRef" type="string"/>
			<tns:parameter name="pcId" type="string"/>
			<tns:parameter name="subscriberAccountId" type="string"/>
			<tns:parameter name="ciPropertiesFile" type="string"/>
			<tns:parameter name="consumptionDate" type="date"/>
			<tns:parameter name="sapCcApi" type="string"/>
			<tns:parameter name="testExtension" type="string"/>
			<tns:parameter name="generateCit" type="string"/>
					
			<!-- MCIT input properties -->
			<tns:parameter name="duration" type="number"/>	
			<tns:parameter name="billing_party" type="string"/>	
			<tns:parameter name="called_number" type="string"/>	
			<tns:parameter name="plmn" type="string"/>	
			<tns:parameter name="tadig" type="string"/>	
			<tns:parameter name="fup_code" type="string"/>	
			<tns:parameter name="cdr_cost" type="number"/>	
			<tns:parameter name="transaction_type" type="string"/>
			<tns:parameter name="source_id" type="string"/>
			<!-- MUSG output properties -->
			<tns:parameter name="bit_amount" type="number"/>			
			<tns:parameter name="bit_quantity" type="number"/>
			<tns:parameter name="bitdate_from" type="date"/>
			<tns:parameter name="bitdate_to" type="date"/>
			<tns:parameter name="zz_in_out" type="string"/>
			<tns:parameter name="zz_voicesmsdata" type="string"/>
			<tns:parameter name="zz_ch_quantity" type="number"/>
			<tns:parameter name="zz_ch_uom" type="string"/>
			<tns:parameter name="zz_log_chg_qty" type="number"/>
			<tns:parameter name="zz_log_alw_qty" type="number"/>			
			<tns:parameter name="zz_domintroam" type="string"/>
			<tns:parameter name="zz_event_usp" type="string"/>
			<tns:parameter name="zz_orig_zone" type="string"/>
			<tns:parameter name="zz_dest_zone" type="string"/>
			<tns:parameter name="zz_orig_country" type="string"/>
			<tns:parameter name="zz_dest_country" type="string"/>
			<tns:parameter name="zz_orig_dscr" type="string"/>
			<tns:parameter name="zz_dest_dscr" type="string"/>
			<tns:parameter name="zz_orig_zon_sch" type="string"/>
			<tns:parameter name="zz_dest_zon_sch" type="string"/>
			<tns:parameter name="zz_prc_group" type="string"/>
			<tns:parameter name="zz_price_id" type="string"/>
			<tns:parameter name="zz_roam_prc_type" type="string"/>
			<tns:parameter name="zz_tariff" type="number"/>
			<tns:parameter name="zz_tax_code" type="string"/>
			<tns:parameter name="zz_exem_price" type="number"/>
			<tns:parameter name="zz_det_inv_digit" type="string"/>
			<tns:parameter name="printrel" type="string"/>
			<!-- properties that are not always present in output -->
			<tns:parameter name="zz_exem_price_present" type="string" defaultValue="true"/>
			<tns:parameter name="zz_log_alw_qty_present" type="string" defaultValue="true"/>
        </tns:parameters>
    </tns:header>
	
    <tns:testData>	

		<tns:test>
            <tns:id>SO-2274760</tns:id>
			<!-- Roaming voice call from EU country to unknown B-party 	 -->
			<tns:labels>BUGFIX</tns:labels>

            <!-- path to the properties file -->
            <tns:parameter name="ciPropertiesFile" paramValue="$_TEST_COMMON_DIR/template/telia-mcit-voi.properties"/>                      
			<tns:parameter name="sapCcApi" paramValue="WebService"/>
			<tns:parameter name="generateCit" paramValue="true"/>
			<tns:parameter name="testExtension" paramValue="$_TEST_DIR/ext/validate-voi-output.xml"/>
			
			<!-- input properties specific for test scenario -->
			<tns:parameter name="consumptionDate" paramValue="${CURRENT_YEAR}-03-04T10:26:46"/>	
			<tns:parameter name="duration" paramValue="57"/>			
			<tns:parameter name="billing_party" paramValue="9014"/>
			<tns:parameter name="called_number" paramValue="9014"/>
			<tns:parameter name="plmn" paramValue="27203"/>
			<tns:parameter name="tadig" paramValue="IRLME"/>
			<tns:parameter name="cdr_cost" paramValue="0.014240"/>			
			<tns:parameter name="transaction_type" paramValue="MOC"/>
			<tns:parameter name="source_id" paramValue="TAP_IN"/>
						
							
			<!-- output charged item validations, different from default value specified in testExtension file -->					
			<tns:parameter name="bit_amount" paramValue="0.000000"/>			
			<tns:parameter name="bit_quantity" paramValue="57.000000"/>			
			<tns:parameter name="zz_ch_quantity" paramValue="60.000000"/>
			<tns:parameter name="zz_ch_uom" paramValue="S"/>
			<tns:parameter name="zz_log_chg_qty" paramValue="60.000000"/>
			<tns:parameter name="zz_log_alw_qty" paramValue="0.000000"/>
			<tns:parameter name="zz_domintroam" paramValue="R"/>
			<tns:parameter name="zz_in_out" paramValue="O"/>
			<tns:parameter name="zz_voicesmsdata" paramValue="V"/>
			<tns:parameter name="zz_event_usp" paramValue="MOC_ROAM"/>
			<tns:parameter name="zz_orig_zone" paramValue="EU"/>
			<tns:parameter name="zz_dest_zone" paramValue="LOCAL"/>
			<tns:parameter name="zz_orig_country" paramValue="HKG"/>
			<tns:parameter name="zz_dest_country" paramValue="HKG"/>
			<tns:parameter name="zz_roam_prc_type" paramValue="RLAH"/>
			<tns:parameter name="zz_tariff" paramValue="0.000000"/>
			<tns:parameter name="zz_tax_code" paramValue="PVM1"/>			
        </tns:test>

	
		
    </tns:testData>
</tns:testTemplate>
