    <!-- wrapper to run ant task with external library provided -->
    <macrodef name="runAntTargetWrapper">
        <attribute name="pLibDir"/>
        <attribute name="pBuildFile"/>
        <attribute name="pTarget"/>

        <sequential>
            <property environment="env"/>
            <condition property="antExecutable" value="cmd" else="bash">
                <os family="windows"/>
            </condition>
            <condition property="isWindows" value="win">
                <os family="windows"/>
            </condition>

            <exec executable="${antExecutable}" unless:set="isWindows">
                <arg value="ant"/>
                <arg value="-lib"/>
                <arg value="@{pLibDir}"/>
                <arg value="-f"/>
                <arg file="@{pBuildFile}"/>
                <arg value="@{pTarget}"/>
            </exec>

            <exec executable="${antExecutable}" if:set="isWindows">
                <arg value="/c"/>
                <arg value="ant.bat"/>
                <arg value="-lib"/>
                <arg value="@{pLibDir}"/>
                <arg value="-f"/>
                <arg file="@{pBuildFile}"/>
                <arg value="@{pTarget}"/>
            </exec>

        </sequential>
    </macrodef>

