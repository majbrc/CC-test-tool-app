                <sysproperty key="testLogDir" value="@{pTestLogDir}"/>
                <sysproperty key="createClassSubDirForLogs" value="@{pCreateClassSubDirForLogs}"/>
                <sysproperty key="testTemplateInput" value="@{pTestTemplateInput}"/>

                <config/>

                <classpath>
                    <pathelement location="${basedir}/${test.framework.jar.classpath}"/>
                </classpath>

            </testng>
        </sequential>

