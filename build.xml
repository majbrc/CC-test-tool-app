        <attribute name="pTestJar" default="${test.jar.dir}/${test.jar}"/>
        <attribute name="pXmlFilesetRef"/>
        <element name="config" optional="true"/>

        <sequential>
            <unzip src="${ext.lib.dir}/${jul.formatter.lib.name}" dest="@{pTestLogDir}/${user.name}" overwrite="true">
                <patternset>
                    <include name="test-log.css"/>
                    <include name="verso-altima.css"/>
