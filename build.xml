                    xmlfilesetref="@{pXmlFilesetRef}">

                <jvmarg value="-DtestConsoleLoggerLevel=@{pTestColsoleLoggerLevel}"/>
                <jvmarg value="-DreportTemplateDir=@{pTestReportTemplatesDir}"/>
                <jvmarg value="-DfwInternalTemplatesDir=@{pFrameworkInternalTemplatesDir}"/>
